# Google AI Studio se key lein: https://aistudio.google.com/apikey
# Asli key yahan mat likhein (yeh file share/push hoti hai). App ke "API keys" button se key add karein.
GEMINI_API_KEY=

# Optional settings
TTS_MODEL=gemini-3.8-flash-tts
# Lambi script kitne characters ke hisson mein jaye (voice/accent stable rehta hai). 0 = ek request.
CONSISTENCY_CHUNK_CHARS=900
# Saari keys rate limit par hon to itne second ruk kar dobara try
CHUNK_DELAY_SEC=21
RATE_LIMIT_RETRIES=4
# Subtitle script conversion ka model (khaali = newest Flash khud chuna jayega)
TEXT_MODEL=
# Voice Agent (Live) model. KHAALI chhorein: app Google catalog se apni key ke liye sahi Live model khud dhoondh leti hai.
# Sirf tab likhein jab kisi khaas model par lock karna ho (bina "models/" ke). Galat naam par Voice Agent "HTTP 404" deta hai.
LIVE_MODEL=
